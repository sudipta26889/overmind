DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Encrypts stored provider credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Comma-separated allowed hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Path of the Django admin (default admin/). Set a private value on a public deployment.
DJANGO_ADMIN_PATH=admin

# Clerk sign-in for the hosted Console. Leave blank for self-hosted local auth:
# the Console uses POST /api/auth/local/ (email + password, no verification) when
# VITE_SELF_HOSTED=true and VITE_CLERK_PUBLISHABLE_KEY is blank. API keys and
# guest sessions still work either way. Secret from https://dashboard.clerk.com/.
CLERK_API_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Canonical MCP resource URL for OAuth discovery; required on hosted deployments.
MCP_SERVER_URL=http://localhost:8000/api/mcp/
# Public domain-ownership token from the OpenAI plugin submission page.
OPENAI_APPS_CHALLENGE=

DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# ─── Database ────────────────────────────────────────────────────────────────
# Blank uses the bundled docker compose postgres (overbae/overbae@postgres:5432).
# Set these to point at an external Postgres instead.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# ─── Celery / Redis ──────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Django cache (Redis). Defaults to redis://redis:6379/1; point at your Redis if external.
CACHE_URL=

# ─── Required: model provider ────────────────────────────────────────────────
# Every model call goes through one OpenAI-compatible gateway (LiteLLM). The API refuses to
# start without OPENROUTER_API_KEY and OPENROUTER_BASE_URL. The key should allow only the models
# named below; the gateway answers 403 to any other.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
# Comma-separated catalog names the gateway routes, per role. An empty chain turns the role off.
# judge: live trace scoring, one slow local call at a time. fast: person-started judges, evals
# and task classification. explain: reasons for low scores in eval runs. agent: agent runs.
# fast and explain stay empty (remote models off) until the PII-protection plan's steps 1-3 and 5 pass.
LLM_JUDGE_CHAIN=local-judge
LLM_FAST_CHAIN=
LLM_EXPLAIN_CHAIN=
LLM_AGENT_CHAIN=flint
# cloud_judge: the remote judge for projects an admin approved for remote judging
# (manage.py set_project_cloud_judging). First entry only; a local model is refused. Empty keeps
# every project on the local judge.
LLM_CLOUD_JUDGE_CHAIN=
# The remote judge's own key, in a file only the masking worker mounts (see deploy/stack.yml).
LLM_CLOUD_API_KEY_FILE=
# Set to 1 on the masking worker only; it loads the name model before forking.
MASKING_ENABLED=
MASKING_MODEL_DIR=
MASKING_MODEL_REVISION=
# The context model (GLiNER) beside the name model, and its detection threshold.
MASKING_CONTEXT_DIR=
MASKING_CONTEXT_REVISION=
MASKING_CONTEXT_THRESHOLD=
# "true" only where a masking worker consumes the masking queue (deploy/stack.yml). Without it
# every project is judged locally and nothing is queued to an empty queue.
MASKING_QUEUE_ENABLED=
# Share of traces live scoring judges (0-1], chosen by trace id. The local judge answers about
# 3,000 spans a day, so this keeps arrivals near that capacity.
TRACE_SCORING_SAMPLE_RATE=0.15
# Judge calls per UTC day: the shared NUC GPU's budget. Work waits for the next day once spent.
JUDGE_DAILY_LIMIT=3000
# Remote judge and explanation calls per UTC day: a bound on spend for certified projects.
CLOUD_JUDGE_DAILY_LIMIT=20000

FRONTEND_URL=http://localhost:5173

# Optional. Existing core MCP telemetry uses this PostHog project.
# Empty disables it. Unset, hosted deployments (Clerk, not DEBUG) use the Overmind
# project's token from settings.py. Project token (phc_...) from PostHog project settings.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
# Optional read-only PostHog query access for Overwatch product usage and conversion insights.
# Use a personal or project secret key with project query read permission.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# Private API host (EU: https://eu.posthog.com, US: https://us.posthog.com).
POSTHOG_API_HOST=https://eu.posthog.com

# Overwatch Slack runs in the Overlord repository. This server only exposes reads.
# Dedicated service key, distinct from SALES_DASHBOARD_TOKEN. Generate: openssl rand -hex 32
OVERWATCH_SERVICE_TOKEN=

# ─── Stripe billing ─────────────────────────────────────────────────
# Set STRIPE_SECRET_KEY to inject remaining-credit billing (cloud). Leave it
# empty for OSS: usage is still metered and shown, with no remaining-credit cap.
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks.
# Endpoint: POST /api/billing/webhook/  (listen for invoice.paid).
STRIPE_WEBHOOK_SECRET=
# Pro plan recurring price id (defaults to the live Pro price if unset).
STRIPE_PRO_PRICE_ID=price_1TvfC1CgXbweROl8gtGzCSV6
# One Overmind Credit at $0.01, one-time. Top-up checkout quantity = credits bought.
# Sandbox value below (product prod_Uxk0NXK4DO91Sz); prod uses
# price_1TxoTvCgXbweROl8s9G4WsfI (product prod_UxjxGrapXS061n).
STRIPE_CREDIT_PRICE_ID=price_1TxoWdCjF8jVtWKgOWHw2oFE

# ─── Internal Overwatch user insights ───────────────────────────────
# Existing bearer token for /api/internal/overwatch/* (legacy env var name).
# Empty disables the endpoints. Generate with: openssl rand -hex 32
SALES_DASHBOARD_TOKEN=

# ─── AWS (optional — needed for Textract OCR and Comprehend PII) ─────
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Optional overrides (defaults work out of the box with docker compose) ───
# SECRET_KEY=change-me-in-production
# DEBUG=false
# FRONTEND_URL=http://localhost:8000

# ─── Slack notifications ─────────────────────────────────────────────────────
# Set this to your Slack incoming webhook URL to get a message in your channel
# whenever a user submits feedback.
# SLACK_FEEDBACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── Required: training and serving ──────────────────────────────────────────
# The API refuses to start until HF_TOKEN, MODAL_TOKEN_ID, MODAL_TOKEN_SECRET,
# INFERENCE_API_URL, INFERENCE_API_KEY, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# and AWS_BUCKET_NAME are set.
# Hugging Face token for gated base models (https://huggingface.co/settings/tokens).
# Also add it to the Modal secret overmind-inference.
HF_TOKEN=

# Finetuning
BASETEN_API_KEY=
BASETEN_PROJECT=
FINETUNING_BACKEND=modal

# Modal tokens: https://modal.com/settings/tokens. INFERENCE_API_URL is printed
# by `modal deploy`; INFERENCE_API_KEY is a shared secret you choose and also set
# in the Modal secret overmind-inference. Set MODAL_ENVIRONMENT explicitly for training and deployment.
INFERENCE_API_URL=
INFERENCE_API_KEY=
MODAL_ENVIRONMENT=overmind-dev
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

TOGETHER_API_KEY=

# Fine-tuning checkpoint S3 archive (baseten/modal providers) — durable home
# for checkpoint.zip/job_logs.txt/metrics.json, see
# overbae/modal/register_model.py's sync_*_to_s3. Django reads these for
# presigned download URLs. Same keys must also be on the "overmind-inference"
# Modal secret for CloudBucketMount. Bucket name is hardcoded in
# register_model.py from MODAL_ENVIRONMENT (not read from this env at Modal
# deploy time). Unrelated to FileField storage (local unless the hosted
# buckets below are set).
# Self-hosted S3-compatible endpoint (e.g. MinIO); blank = AWS S3.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=eu-west-1

# Hosted opt-in: FileField / staticfiles S3. Unset = local MEDIA_ROOT / STATIC_ROOT.
# AWS_STORAGE_BUCKET_NAME=
# AWS_STATIC_BUCKET_NAME=
# When DJANGO_DEBUG is false, STATIC_URL defaults to https://static.overmindlab.ai/
# (ECS does not inject this). Set it to override; leave unset rather than empty.
AWS_S3_CUSTOM_DOMAIN=

# ─── Grafana ─────────────────────────────────────────────────────────────────
# Admin password for the local Grafana instance (http://localhost:3001)
# Defaults to "admin" if unset — change for any shared environment
GRAFANA_ADMIN_PASSWORD=
# AWS SSO profile used by Grafana to query CloudWatch (defaults to administrator)
AWS_PROFILE=administrator
# Per-project interactive package execution slots (shared across workers).
WORKSHOP_PROJECT_CONCURRENCY=2

# Isolated document extraction (required for document uploads).
SANDBOX_URL=http://sandbox:8080
SANDBOX_TOKEN=change-me-in-production
